# Copy to .env on the GPU host. Do NOT commit real tokens.
AIVAULT_VOICE_TOKEN=change-me-to-a-random-string-at-least-24-chars
AIVAULT_VOICE_DATA=/data
AIVAULT_VOICE_HOST=0.0.0.0
AIVAULT_VOICE_PORT=8090
# Speak clone anchor (mounted into container /data)
DAWN_SPEAK_REF=/data/dawn-natural-female-v3-speak.wav
DAWN_VOICE_ID=dawn_v3
# Optional: point Edge dawn-own-tts at this host (server-side only)
# DAWN_OWN_TTS_UPSTREAM=https://tts.example.com
